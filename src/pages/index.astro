---
// src/pages/index.astro
import AtelierLayout from '../layouts/AtelierLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import ResearchProjects from '../components/ResearchProjects.astro';
import Skills from '../components/Skills.astro';
import Certifications from '../components/Certifications.astro';
import ResumeSection from '../components/ResumeSection.astro';
import Contact from '../components/Contact.astro';
import { PORTFOLIO_DATA } from '../data/portfolioData';
---

<AtelierLayout 
  title={`${PORTFOLIO_DATA.profile.fullName} | The Digital Atelier | Software Engineering & Applied AI`}
  description={`${PORTFOLIO_DATA.profile.fullName} — ${PORTFOLIO_DATA.profile.headline}. Integrated M.Tech SE student at VIT-AP ('28, CGPA 9.13/10). Active research in TerraSeg AI & AquaGuard AI.`}
>
  <!-- 1. Hero Section -->
  <Hero />

  <!-- 2. About Section -->
  <About />

  <!-- 3. Research & Projects Section -->
  <ResearchProjects />

  <!-- 4. Skills Taxonomy Section -->
  <Skills />

  <!-- 5. Professional Certifications Section -->
  <Certifications />

  <!-- 7. Master Resume Section -->
  <ResumeSection />

  <!-- 8. Contact & Transmission Section -->
  <Contact />
</AtelierLayout>
