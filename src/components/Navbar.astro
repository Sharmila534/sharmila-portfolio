---
// src/components/Navbar.astro
import { PORTFOLIO_DATA } from '../data/portfolioData';
---

<header class="atelier-header" role="banner">
  <div class="atelier-container">
    <nav class="nav-shell" aria-label="Main Navigation">
      <a href={`${import.meta.env.BASE_URL}#hero`} class="brand-stamp" aria-label={`${PORTFOLIO_DATA.profile.fullName} Home`}>
        <span class="monogram-pill">{PORTFOLIO_DATA.profile.monogram}</span>
        <div class="brand-text">
          <span class="brand-name">{PORTFOLIO_DATA.profile.fullName}</span>
          <span class="brand-sub">The Digital Atelier</span>
        </div>
      </a>

      <button type="button" class="nav-toggle" aria-label="Open navigation" aria-controls="primary-navigation" aria-expanded="false">
        <span class="nav-toggle-lines" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>

      <ul class="nav-links" id="primary-navigation" role="list">
        <li class="nav-indicator-item" aria-hidden="true"><span class="nav-indicator"></span></li>
        <li><a href={`${import.meta.env.BASE_URL}#about`} class="nav-item">About</a></li>
        <li><a href={`${import.meta.env.BASE_URL}#projects`} class="nav-item">Research & Projects</a></li>
        <li><a href={`${import.meta.env.BASE_URL}#skills`} class="nav-item">Skills</a></li>
        <li><a href={`${import.meta.env.BASE_URL}#certifications`} class="nav-item">Certifications</a></li>
        <li><a href={`${import.meta.env.BASE_URL}#resume`} class="nav-item">Resume</a></li>
        <li><a href={`${import.meta.env.BASE_URL}#contact`} class="nav-item">Contact</a></li>
      </ul>

      <div class="header-actions">
        <button type="button" class="btn-recruiter-pill" data-open-recruiter aria-haspopup="dialog" aria-expanded="false">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
          <span>Recruiter View</span>
        </button>

        <a href={`${import.meta.env.BASE_URL}Sai_Sharmila_Kinjarapu_Resume.pdf`} download class="cv-link" aria-label="Download Master Resume PDF">
          <span>CV</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .atelier-header {
    position: fixed;
    top: 1.25rem;
    left: 0;
    right: 0;
    z-index: 50;
    pointer-events: none;
  }
  .nav-shell {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255, 253, 250, 0.86);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--color-rose-gold-light);
    border-radius: var(--radius-pill);
    padding: 0.55rem 1.25rem 0.55rem 0.85rem;
    box-shadow: 0 8px 24px -4px rgba(42, 22, 37, 0.08);
  }
  .brand-stamp {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-plum-deep);
  }
  .monogram-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    background: var(--color-plum-deep);
    color: var(--color-canvas-ivory);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    border-radius: 50%;
    border: 1px solid var(--color-rose-gold);
  }
  .brand-text { display: flex; flex-direction: column; }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.1;
    color: var(--color-plum-deep);
  }
  .brand-sub {
    font-size: 0.7rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-rose-gold-text);
  }
  .nav-links {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.35rem;
    list-style: none;
  }
  .nav-item {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-ink-blackberry);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .nav-item:hover, .nav-item[aria-current="location"] { color: var(--color-plum-deep); }
  .nav-indicator-item { position: absolute; inset: 0; list-style: none; pointer-events: none; }
  .nav-indicator {
    position: absolute;
    left: 0;
    bottom: 0.05rem;
    width: var(--indicator-width, 0px);
    height: 2px;
    border-radius: 2px;
    background: var(--color-rose-gold);
    opacity: 0;
    transform: translateX(var(--indicator-x, 0px));
    transition: width var(--transition-smooth), transform var(--transition-smooth), opacity var(--transition-fast);
    pointer-events: none;
  }
  .nav-indicator.is-active { opacity: 1; }
  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-rose-gold-light);
    border-radius: 50%;
    color: var(--color-plum-deep);
    background: rgba(255, 253, 250, 0.9);
    cursor: pointer;
  }
  .nav-toggle-lines { display: grid; gap: 4px; width: 17px; }
  .nav-toggle-lines i { display: block; width: 100%; height: 1.5px; border-radius: 2px; background: currentColor; transition: transform var(--transition-fast), opacity var(--transition-fast); }
  .nav-toggle[aria-expanded="true"] .nav-toggle-lines i:first-child { transform: translateY(5.5px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] .nav-toggle-lines i:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded="true"] .nav-toggle-lines i:last-child { transform: translateY(-5.5px) rotate(-45deg); }
  .header-actions { display: flex; align-items: center; gap: 0.75rem; }
  .cv-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-plum-deep);
    text-decoration: none;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-pill);
    background: rgba(244, 237, 228, 0.75);
    border: 1px solid var(--color-rose-gold-light);
    transition: all var(--transition-fast);
  }
  .cv-link:hover {
    border-color: var(--color-rose-gold-text);
    background: var(--color-blush-subtle);
  }
  @media (max-width: 1040px) {
    .atelier-header { top: 0.75rem; }
    .nav-shell { position: relative; gap: 0.6rem; padding: 0.45rem 0.6rem 0.45rem 0.75rem; }
    .nav-toggle { display: inline-flex; order: 3; }
    .header-actions { order: 2; margin-left: auto; }
    .nav-links {
      display: none;
      position: absolute;
      z-index: 2;
      top: calc(100% + 0.65rem);
      right: 0;
      width: min(23rem, calc(100vw - 2.5rem));
      max-height: min(70vh, 32rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 0.6rem;
      border: 1px solid var(--color-rose-gold-light);
      border-radius: var(--radius-lg);
      background: rgba(255, 253, 250, 0.97);
      box-shadow: var(--shadow-lg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }
    .nav-links.is-open { display: grid; gap: 0.15rem; }
    .nav-links > li { min-width: 0; }
    .nav-item { width: 100%; min-height: 46px; padding: 0.5rem 0.75rem; border-radius: var(--radius-sm); }
    .nav-item:hover, .nav-item[aria-current="location"] { background: var(--color-blush-subtle); }
    .nav-indicator { display: none; }
  }
  @media (max-width: 540px) {
    .atelier-header .atelier-container { padding-inline: 0.6rem; }
    .brand-stamp { gap: 0.5rem; }
    .brand-stamp { flex:1 1 auto; overflow:hidden; }
    .brand-text { min-width:0; overflow:hidden; }
    .brand-name { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.78rem; }
    .brand-sub { font-size: 0.52rem; }
    .monogram-pill { width: 32px; height: 32px; flex: 0 0 32px; }
    .btn-recruiter-pill { width: 40px; height: 40px; padding: 0; justify-content: center; }
    .btn-recruiter-pill span { display: none; }
    .header-actions { gap: 0.4rem; }
    .cv-link { display: none; }
    .nav-shell { width: 100%; min-width: 0; gap: 0.45rem; border-radius: 1.5rem; }
    .header-actions { flex: 0 0 40px; margin-left:auto; }
    .nav-toggle { width: 38px; height: 38px; flex-basis: 38px; }
  }
  @media (hover: none) {
    .nav-item:hover { color: var(--color-ink-blackberry); }
  }
</style>
