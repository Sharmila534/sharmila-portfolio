---
// src/components/Contact.astro
import { PORTFOLIO_DATA } from '../data/portfolioData';
---

<section id="contact" class="contact-section" data-section-motion="transmission" aria-labelledby="contact-title">
  <div class="atelier-container">
    <div class="room-header reveal-on-scroll">
      <div class="room-meta">
        <span class="atelier-badge">TRANSMISSION & COLLABORATION</span>
        <span class="contact-stamp">OPEN FOR INTERNSHIPS</span>
      </div>
      <h2 id="contact-title" class="editorial-title contact-heading">
        Initiate <span class="editorial-italic">Transmission.</span>
      </h2>
      <p class="contact-lead">
        I am open to software engineering and applied AI/ML internship opportunities, as well as research collaborations.
      </p>
    </div>

    <img class="contact-artwork" src={`${import.meta.env.BASE_URL}images/atelier/contact-botanical.webp`} alt="" aria-hidden="true" width="1536" height="1024" loading="lazy" />

    <!-- Contact Channels Grid -->
    <div class="contact-grid reveal-on-scroll" data-transition-panel>
      <!-- Direct Email Card -->
      <a href={`mailto:${PORTFOLIO_DATA.links.email}`} class="atelier-card contact-channel-card">
        <div class="ch-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
        </div>
        <div class="ch-info">
          <span class="ch-type">PRIMARY EMAIL</span>
          <span class="ch-address">{PORTFOLIO_DATA.links.email}</span>
          <span class="ch-hint">Click to launch mail client ↗</span>
        </div>
      </a>

      <!-- LinkedIn Card -->
      <a href={PORTFOLIO_DATA.links.linkedin} target="_blank" rel="noopener noreferrer" class="atelier-card contact-channel-card">
        <div class="ch-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </div>
        <div class="ch-info">
          <span class="ch-type">LINKEDIN PROFILE</span>
          <span class="ch-address">Sai Sharmila Kinjarapu</span>
          <span class="ch-hint">Connect professionally ↗</span>
        </div>
      </a>

      <!-- GitHub Card -->
      <a href={PORTFOLIO_DATA.links.github} target="_blank" rel="noopener noreferrer" class="atelier-card contact-channel-card">
        <div class="ch-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
        </div>
        <div class="ch-info">
          <span class="ch-type">GITHUB PROFILE</span>
          <span class="ch-address">Open Source & Research Repos</span>
          <span class="ch-hint">Explore codebases ↗</span>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding-top: clamp(4rem, 8vw, 7rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid rgba(232, 213, 208, 0.4);
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: linear-gradient(138deg, rgba(241,233,244,.78), rgba(253,246,239,.9) 55%, rgba(245,232,231,.8));
  }
  .contact-section::before { content: ""; position: absolute; z-index: -1; width: min(74vw,940px); aspect-ratio: 1; right: -28%; bottom: -42%; border-radius: 50%; background: radial-gradient(circle at center, transparent 0 28%, rgba(143,110,156,.12) 28.2% 28.6%, transparent 28.8% 42%, rgba(197,143,125,.16) 42.2% 42.6%, transparent 42.8% 56%, rgba(143,110,156,.10) 56.2% 56.5%, transparent 56.8%), radial-gradient(circle at 52% 49%, rgba(255,255,255,.8), rgba(220,198,218,.25) 34%, transparent 70%); transform: rotateX(68deg) rotateZ(-18deg); pointer-events: none; animation: contact-rotation 52s linear infinite; }
  @keyframes contact-rotation { to { transform: rotateX(68deg) rotateZ(342deg); } }
  .contact-stamp {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-rose-gold-text);
    letter-spacing: 0.05em;
  }
  .contact-heading {
    font-size: var(--font-h1);
    margin-bottom: 1rem;
  }
  .contact-lead {
    font-size: var(--font-lead);
    color: var(--color-taupe-muted);
    line-height: 1.6;
    max-width: 820px;
  }
  .contact-artwork {
    display: block;
    width: 100%;
    max-height: 260px;
    object-fit: cover;
    object-position: center 42%;
    border-radius: var(--radius-lg);
    margin-top: 2rem;
    border: 1px solid var(--color-rose-gold-light);
    transform: perspective(1200px) rotateX(1.5deg) rotateY(-1.1deg) translateZ(14px);
    box-shadow: 0 28px 46px -38px rgba(49,27,53,.52);
    transition: transform 700ms cubic-bezier(.2,.75,.25,1), box-shadow 700ms ease;
  }
  .contact-artwork:hover { transform: perspective(1200px) rotateX(0) rotateY(0) translate3d(0,-4px,25px); box-shadow: 0 34px 54px -38px rgba(49,27,53,.58); }
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }
  .contact-channel-card {
    padding: 1.75rem;
    display: flex;
    align-items: flex-start;
    gap: 1.15rem;
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-smooth), border-color var(--transition-smooth);
  }
  .contact-channel-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-rose-gold-text);
  }
  .ch-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-blush-subtle);
    border: 1px solid var(--color-rose-gold-light);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-rose-gold-text);
    flex-shrink: 0;
  }
  .ch-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .ch-type {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--color-rose-gold-text);
    font-weight: 700;
  }
  .ch-address {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-plum-deep);
    word-break: break-all;
  }
  .ch-hint {
    font-size: 0.75rem;
    color: var(--color-taupe-muted);
  }
  @media (max-width: 992px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { .contact-artwork, .contact-artwork:hover { transform: none; } .contact-section::before { animation: none; } }
</style>
