---
// src/components/Certifications.astro
import { PORTFOLIO_DATA } from '../data/portfolioData';
---

<section id="certifications" class="certifications-section" data-section-motion="credentials" aria-labelledby="certs-title">
  <div class="atelier-container">
    <div class="room-header reveal-on-scroll">
      <div class="room-meta">
        <span class="atelier-badge">CERTIFICATES & COURSES</span>
        <span class="certs-stamp">PROFESSIONAL SPECIALIZATIONS</span>
      </div>
      <h2 id="certs-title" class="editorial-title certs-heading">
        Industry & Academic <span class="editorial-italic">Certifications.</span>
      </h2>
      <p class="certs-lead">
        Rigorous programs completed via Coursera spanning advanced data analytics, statistical modeling, business intelligence dashboards, and large language model prompt engineering.
      </p>
    </div>

    <img class="section-artwork certification-artwork" src={`${import.meta.env.BASE_URL}images/atelier/certification-seal.webp`} alt="Embossed rose-gold certification seal on ivory paper" width="1536" height="1024" loading="lazy" />

    <!-- Credential cards link to the supplied Coursera share pages. -->
    <div class="certs-grid">
      {PORTFOLIO_DATA.certifications.map((cert, idx) => (
        <a 
          href={cert.verificationUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          data-transition-panel style={`--reveal-order: ${Math.min(idx, 3)}; --panel-order:${idx}`} class="atelier-card cert-card reveal-on-scroll"
          aria-label={`Verify ${cert.title} on ${cert.platform}`}
        >
          <div class="cert-card-header">
            <div class="cert-issuer-badge">
              <span class="issuer-name">{cert.issuer}</span>
              <span class="platform-dot">•</span>
              <span class="platform-name">{cert.platform}</span>
            </div>
            <div class="verify-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17l9.2-9.2M17 17V7H7"/>
              </svg>
            </div>
          </div>

          <h3 class="cert-title">{cert.title}</h3>
          <p class="cert-desc">{cert.description}</p>

          <div class="cert-skills-wrap">
            {cert.skillsCovered.map(sk => (
              <span class="cert-skill-chip">{sk}</span>
            ))}
          </div>

          <div class="cert-footer">
            <span class="verify-text">Open credential</span>
            <span class="verify-action">Verify ↗</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .certifications-section {
    padding-top: clamp(4rem, 8vw, 7rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid rgba(232, 213, 208, 0.4);
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: linear-gradient(112deg, rgba(249,241,232,.88), rgba(248,240,244,.68) 56%, rgba(241,233,244,.58));
  }
  .certifications-section::before {
    content: ""; position: absolute; z-index: -1; width: min(54vw,650px); aspect-ratio: 1; left: -23%; top: 9%; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle, rgba(255,255,255,.82) 0 26%, rgba(212,173,151,.22) 26.5% 27.2%, transparent 27.6% 42%, rgba(189,155,188,.18) 42.5% 43.1%, transparent 43.5% 58%, rgba(212,173,151,.17) 58.5% 59%, transparent 59.5%);
    transform: rotateX(70deg) rotateZ(22deg); filter: drop-shadow(10px 22px 18px rgba(49,27,53,.08)); animation: seal-turn 54s linear infinite;
  }
  @keyframes seal-turn { to { transform: rotateX(70deg) rotateZ(382deg); } }
  .certs-stamp {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-rose-gold-text);
    letter-spacing: 0.05em;
  }
  .certs-heading {
    font-size: var(--font-h1);
    margin-bottom: 1rem;
  }
  .certs-lead {
    font-size: var(--font-lead);
    color: var(--color-taupe-muted);
    line-height: 1.6;
    max-width: 820px;
  }
  .certification-artwork {
    display: block;
    width: 100%;
    max-height: 220px;
    object-fit: cover;
    object-position: center 45%;
    border-radius: var(--radius-lg);
    margin-top: 2rem;
    border: 1px solid var(--color-rose-gold-light);
  }
  .certs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
    margin-top: 3rem;
  }
  .cert-card {
    padding: clamp(1.75rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transform-style: preserve-3d;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.82), 0 15px 30px -28px rgba(49,27,53,.54);
  }
  .cert-card::before { content: ""; position: absolute; width: 150px; height: 150px; top: -74px; right: -54px; border-radius: 50%; border: 1px solid rgba(197,143,125,.25); box-shadow: 0 0 0 9px rgba(197,143,125,.045), 0 0 0 20px rgba(197,143,125,.035), inset 0 0 24px rgba(197,143,125,.08); pointer-events: none; transition: transform 650ms cubic-bezier(.2,.75,.25,1); }
  .cert-card:focus-visible { transform: perspective(1000px) rotateX(1.2deg) translateY(-5px); box-shadow: var(--shadow-md); border-color: var(--color-rose-gold-text); }
  @media (hover: hover) and (pointer: fine) {
    .cert-card:hover { transform: perspective(1000px) rotateX(2deg) rotateY(-1.4deg) translateY(-7px); box-shadow: var(--shadow-lg); border-color: var(--color-rose-gold-text); }
    .cert-card:nth-child(even):hover { transform: perspective(1000px) rotateX(-1.5deg) rotateY(1.4deg) translateY(-7px); }
    .cert-card:hover::before { transform: translate(-9px, 11px) scale(1.08); }
    .cert-card:hover .verify-icon { transform: translate(2px, -2px); color: var(--color-rose-gold-text); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cert-card:hover, .cert-card:focus-visible, .cert-card:nth-child(even):hover { transform: none; }
    .cert-card:hover::before { transform: none; }
    .certifications-section::before { animation: none; }
  }
  /* Keep the original icon color on touch; keyboard focus gets the same cue. */
  .cert-card:focus-visible .verify-icon { transform: translate(2px, -2px); color: var(--color-rose-gold-text); }
  .cert-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  .cert-issuer-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-rose-gold-text);
    font-weight: 600;
  }
  .platform-dot { color: var(--color-taupe-muted); }
  .platform-name { color: var(--color-taupe-muted); font-weight: normal; }
  .verify-icon {
    color: var(--color-taupe-muted);
    transition: transform var(--transition-fast), color var(--transition-fast);
  }
  .cert-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-plum-deep);
    line-height: 1.35;
    margin-bottom: 0.75rem;
  }
  .cert-desc {
    font-size: 0.875rem;
    color: var(--color-ink-blackberry);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }
  .cert-skills-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }
  .cert-skill-chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.2rem 0.55rem;
    background: rgba(244, 237, 228, 0.75);
    border: 1px solid var(--color-rose-gold-light);
    border-radius: var(--radius-pill);
    color: var(--color-plum-deep);
  }
  .cert-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid rgba(232, 213, 208, 0.6);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .verify-text {
    color: var(--color-taupe-muted);
    font-size: 0.7rem;
  }
  .verify-action {
    color: var(--color-plum-deep);
    font-weight: 600;
  }
  @media (max-width: 900px) {
    .certs-grid { grid-template-columns: 1fr; }
  }
</style>
