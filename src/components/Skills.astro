---
// src/components/Skills.astro
import { PORTFOLIO_DATA } from '../data/portfolioData';
---

<section id="skills" class="skills-section" data-section-motion="constellation" aria-labelledby="skills-title">
  <div class="atelier-container">
    <div class="room-header reveal-on-scroll">
      <div class="room-meta">
        <span class="atelier-badge">TECHNICAL TAXONOMY</span>
        <span class="skills-stamp">5 DOCUMENTED DISCIPLINES</span>
      </div>
      <h2 id="skills-title" class="editorial-title skills-heading">
        Skills & <span class="editorial-italic">Engineered Tooling.</span>
      </h2>
      <p class="skills-lead">
        Grouped by domain and tied to project implementations or coursework documented in the supplied repositories.
      </p>
    </div>

    <img class="section-artwork analytics-artwork" src={`${import.meta.env.BASE_URL}images/atelier/analytics-panels.webp`} alt="Minimal translucent data visualization panels" width="1672" height="941" loading="lazy" />

    <!-- 6-Category Matrix Grid -->
    <div class="skills-matrix-grid">
      {PORTFOLIO_DATA.skills.map((cat, idx) => (
        <div data-transition-panel style={`--reveal-order: ${Math.min(idx, 3)}; --panel-order:${idx}`} class="atelier-card skill-cat-card reveal-on-scroll">
          <div class="cat-header">
            <span class="cat-num">0{idx + 1}</span>
            <h3 class="cat-title">{cat.title}</h3>
          </div>
          <p class="cat-desc">{cat.description}</p>

          <div class="skills-items-list">
            {cat.skills.map((s, skillIdx) => (
              <div style={`--skill-order: ${Math.min(skillIdx, 5)}`} class="skill-row">
                <div class="skill-name-wrap">
                  <span class="s-name">{s.name}</span>
                  {s.note && <span class="s-note">{s.note}</span>}
                </div>
                <span class={`level-badge level-${s.level.toLowerCase().replace(/[^a-z0-9]/g, '-')}`}>
                  {s.level}
                </span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-section {
    padding-top: clamp(4rem, 8vw, 7rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid rgba(232, 213, 208, 0.4);
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: linear-gradient(155deg, rgba(240,235,246,.76), rgba(252,248,244,.68) 54%, rgba(246,234,232,.70));
  }
  .skills-section::before {
    content: ""; position: absolute; z-index: -1; inset: 0; opacity: .54; pointer-events: none;
    background-image: radial-gradient(circle, rgba(123,94,134,.34) 1.4px, transparent 1.8px), linear-gradient(28deg, transparent 49.8%, rgba(164,132,161,.11) 50%, transparent 50.2%);
    background-size: 34px 34px, 100% 100%; mask-image: radial-gradient(ellipse at 72% 42%, #000 0, transparent 69%); animation: skill-constellation 26s ease-in-out infinite alternate;
  }
  @keyframes skill-constellation { to { background-position: 17px -17px, 0 0; opacity: .34; } }
  .skills-stamp {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-rose-gold-text);
    letter-spacing: 0.05em;
  }
  .skills-heading {
    font-size: var(--font-h1);
    margin-bottom: 1rem;
  }
  .skills-lead {
    font-size: var(--font-lead);
    color: var(--color-taupe-muted);
    line-height: 1.6;
    max-width: 820px;
  }
  .analytics-artwork {
    display: block;
    width: 100%;
    max-height: 250px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    margin-top: 2rem;
    border: 1px solid var(--color-rose-gold-light);
  }
  .skills-matrix-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
    margin-top: 3rem;
  }
  .skill-cat-card {
    padding: clamp(1.5rem, 2.5vw, 2.25rem);
    display: flex;
    flex-direction: column;
  }
  .skill-row { transition: opacity 0.28s ease, transform 0.28s ease; transition-delay: calc(var(--skill-order, 0) * 35ms); }
  .skill-cat-card.reveal-pending .skill-row { opacity: 0; transform: translateY(5px); }
  .skill-cat-card.is-visible .skill-row { opacity: 1; transform: translateY(0); }
  .cat-header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }
  .cat-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-rose-gold-text);
  }
  .cat-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-plum-deep);
  }
  .cat-desc {
    font-size: 0.8125rem;
    color: var(--color-taupe-muted);
    margin-bottom: 1.25rem;
    line-height: 1.5;
  }
  .skills-items-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-top: 1px solid var(--color-rose-gold-light);
    padding-top: 1rem;
    margin-top: auto;
  }
  .skill-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 0.45rem 0.65rem;
    background: rgba(255, 253, 250, 0.6);
    border: 1px solid rgba(232, 213, 208, 0.45);
    border-radius: var(--radius-sm);
    transform-style: preserve-3d;
    transition: transform 360ms cubic-bezier(.2,.7,.25,1), background 300ms ease, box-shadow 300ms ease;
  }
  @media (hover: hover) and (pointer: fine) { .skill-row:hover { transform: perspective(420px) rotateX(2deg) translate3d(5px,-2px,12px); background: rgba(255,253,250,.94); box-shadow: 0 9px 18px -14px rgba(49,27,53,.42); } }
  .skill-name-wrap {
    display: flex;
    flex-direction: column;
  }
  .s-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-plum-deep);
  }
  .s-note {
    font-size: 0.72rem;
    color: var(--color-taupe-muted);
  }
  .level-badge {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    border: 1px solid transparent;
  }
  .level-proficient {
    background: var(--color-blush-subtle);
    color: var(--color-plum-deep);
    border-color: var(--color-rose-gold-text);
    font-weight: 600;
  }
  .level-practical-project-experience {
    background: rgba(244, 237, 228, 0.85);
    color: var(--color-plum-soft);
    border-color: var(--color-rose-gold-light);
  }
  .level-coursework---academic {
    background: rgba(255, 253, 250, 0.85);
    color: var(--color-taupe-muted);
    border-color: rgba(232, 213, 208, 0.6);
  }
  @media (max-width: 900px) {
    .skills-matrix-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { .skill-row, .skill-row:hover { transform: none; } .skills-section::before { animation: none; } }
</style>
