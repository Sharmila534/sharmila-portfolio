---
// src/components/ResumeSection.astro
import { PORTFOLIO_DATA } from '../data/portfolioData';
---

<section id="resume" class="resume-section" data-section-motion="document" aria-labelledby="resume-title">
  <div class="atelier-container">
    <div class="room-header reveal-on-scroll">
      <div class="room-meta">
        <span class="atelier-badge">CURRICULUM VITAE</span>
        <span class="resume-stamp">UPDATED OCTOBER 2026</span>
      </div>
      <h2 id="resume-title" class="editorial-title resume-heading">
        Master Resume & <span class="editorial-italic">Academic Record.</span>
      </h2>
      <p class="resume-lead">
        Education, project work, technical skills, and certificates summarized for recruiters and collaborators.
      </p>
    </div>

    <div class="resume-wrapper reveal-on-scroll" data-transition-panel>
      <div class="atelier-card atelier-card-elevated resume-card">
        <div class="resume-card-header">
          <div class="res-left">
            <span class="res-doc-type">OFFICIAL MASTER RESUME</span>
            <h3 class="res-cand-name">{PORTFOLIO_DATA.profile.fullName}</h3>
            <span class="res-cand-sub">{PORTFOLIO_DATA.education.degree} • {PORTFOLIO_DATA.education.institution}</span>
          </div>

          <!-- Prominent Action Buttons -->
          <div class="res-action-group">
            <a href={`${import.meta.env.BASE_URL}Sai_Sharmila_Kinjarapu_Resume.pdf`} download="Sai_Sharmila_Kinjarapu_Resume.pdf" class="btn-atelier-primary res-download-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Download Latest Resume (PDF)</span>
            </a>

            <button type="button" class="btn-atelier-secondary" onclick="window.print()">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                <rect x="6" y="14" width="12" height="8"></rect>
              </svg>
              <span>Print View</span>
            </button>
          </div>
        </div>

        <!-- Scannable Resume Summary Grid -->
        <div class="res-preview-grid">
          <div class="res-block">
            <h4 class="block-title">Education & Horizon</h4>
            <div class="block-content">
              <strong>VIT-AP University</strong>
              <p>Integrated M.Tech Software Engineering (2023–2028)</p>
              <span class="res-highlight">CGPA: 9.13 / 10.0</span>
            </div>
          </div>

          <div class="res-block">
            <h4 class="block-title">Flagship Research & Systems</h4>
            <div class="block-content">
              <p>• <strong>TerraSeg AI:</strong> Multi-dataset satellite landslide segmentation research prototype with an implemented Gradio patch-inspection interface; broader workflow consolidation is in progress.</p>
              <p>• <strong>AquaGuard AI:</strong> Multi-agent aquaculture decision-support prototype (Google Gemini).</p>
              <p>• <strong>HMS:</strong> Full-stack learning prototype with Flask, MongoDB, and LLM prompting.</p>
              <p>• <strong>AI Planning:</strong> Classical search algorithms (A*, Minimax, BFS) and PDDL.</p>
            </div>
          </div>

          <div class="res-block">
            <h4 class="block-title">Key Competencies</h4>
            <div class="block-content">
              <p><strong>Languages:</strong> Python, Java, SQL, R</p>
              <p><strong>Systems & AI:</strong> PyTorch, CNN, U-Net, ResNet-34 U-Net, Google ADK, Gemini API, Flask, MongoDB</p>
              <p><strong>Analytics:</strong> EDA, Predictive Modeling, Tableau, Data Cleaning</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .resume-section {
    padding-top: clamp(4rem, 8vw, 7rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid rgba(232, 213, 208, 0.4);
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: radial-gradient(ellipse at 88% 65%, rgba(215,198,220,.48), transparent 38%), linear-gradient(120deg, rgba(249,240,241,.78), rgba(251,247,240,.9));
  }
  .resume-section::before { content: ""; position: absolute; z-index: -1; inset: 0; opacity: .35; background: repeating-linear-gradient(135deg, transparent 0 54px, rgba(143,110,156,.12) 55px 56px, transparent 57px 110px); mask-image: linear-gradient(90deg, transparent, #000 55%, transparent); pointer-events: none; animation: resume-glint 32s linear infinite alternate; }
  @keyframes resume-glint { to { background-position: 92px 38px; } }
  .resume-stamp {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-rose-gold-text);
    letter-spacing: 0.05em;
  }
  .resume-heading {
    font-size: var(--font-h1);
    margin-bottom: 1rem;
  }
  .resume-lead {
    font-size: var(--font-lead);
    color: var(--color-taupe-muted);
    line-height: 1.6;
    max-width: 820px;
  }
  .resume-wrapper {
    margin-top: 3rem;
    perspective: 1500px;
  }
  .resume-card {
    padding: clamp(1.75rem, 3.5vw, 3rem);
    position: relative;
    transform-style: preserve-3d;
    box-shadow: 12px 22px 44px -30px rgba(49,27,53,.5), inset 0 1px 0 rgba(255,255,255,.9);
    transition: transform 560ms cubic-bezier(.2,.72,.25,1), box-shadow 560ms ease;
  }
  .resume-card::before, .resume-card::after { content: ""; position: absolute; z-index: -1; inset: 9px 12px -11px; border: 1px solid rgba(197,143,125,.42); border-radius: inherit; background: linear-gradient(135deg,#fffdfb,#f2e8e7); transform: translateZ(-18px) rotate(.7deg); box-shadow: 0 17px 26px -24px rgba(49,27,53,.42); pointer-events: none; }
  .resume-card::after { inset: 16px 20px -20px; opacity: .56; transform: translateZ(-38px) rotate(1.2deg); }
  @media (hover: hover) and (pointer: fine) { .resume-card:hover { transform: rotateX(1deg) rotateY(-.65deg) translateY(-4px); box-shadow: 20px 32px 54px -34px rgba(49,27,53,.55), inset 0 1px 0 rgba(255,255,255,.95); } }
  .resume-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--color-rose-gold-light);
    margin-bottom: 2rem;
  }
  .res-doc-type {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-rose-gold-text);
    display: block;
    margin-bottom: 0.35rem;
  }
  .res-cand-name {
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--color-plum-deep);
  }
  .res-cand-sub {
    font-size: 0.875rem;
    color: var(--color-taupe-muted);
  }
  .res-action-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .res-download-btn {
    font-size: 1rem;
    padding: 0.85rem 1.75rem;
  }
  .res-preview-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .res-block {
    background: rgba(255, 253, 250, 0.7);
    border: 1px solid var(--color-rose-gold-light);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }
  .block-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-rose-gold-text);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(232, 213, 208, 0.6);
  }
  .block-content {
    font-size: 0.875rem;
    color: var(--color-ink-blackberry);
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .res-highlight {
    display: inline-block;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--color-plum-deep);
    margin-top: 0.25rem;
  }
  @media (max-width: 992px) {
    .res-preview-grid { grid-template-columns: 1fr; }
    .resume-card-header { flex-direction: column; align-items: flex-start; }
    .res-action-group { width: 100%; }
    .res-download-btn { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .resume-card, .resume-card:hover { transform: none; } .resume-section::before { animation: none; } }
</style>
