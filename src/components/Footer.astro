---
// src/components/Footer.astro
import { PORTFOLIO_DATA } from '../data/portfolioData';
const isProjectStory = Astro.url.pathname.startsWith(`${import.meta.env.BASE_URL}projects/`);
const returnHref = isProjectStory ? '#story-top' : `${import.meta.env.BASE_URL}#hero`;
---

<footer class="atelier-footer" role="contentinfo">
  <div class="atelier-container">
    <div class="footer-content">
      <div class="footer-brand">
        <span class="f-monogram">{PORTFOLIO_DATA.profile.monogram}</span>
        <div>
          <span class="f-name">{PORTFOLIO_DATA.profile.fullName}</span>
          <span class="f-sub">The Digital Atelier • Integrated M.Tech SE '28</span>
        </div>
      </div>

      <div class="footer-colophon">
        <p class="colophon-p">
          Crafted with <strong>Astro</strong>, semantic CSS, and lightweight modern JavaScript. Set in <em>Italiana</em>, <em>Cormorant Garamond</em>, <em>Plus Jakarta Sans</em>, and <em>JetBrains Mono</em>.
        </p>
        <p class="colophon-sub">
          Designed with keyboard access and reduced-motion preferences in mind. All links centralized in <code>src/data/portfolioData.ts</code>.
        </p>
      </div>

      <div class="footer-nav">
        <a href={returnHref} class="back-top-btn">
          <span>Return to Top ↑</span>
        </a>
      </div>
    </div>

    <div class="footer-bottom-row">
      <span>© {new Date().getFullYear()} {PORTFOLIO_DATA.profile.fullName}. VIT-AP University.</span>
      <span>Amaravati, Andhra Pradesh, India</span>
    </div>
  </div>
</footer>

<style>
  .atelier-footer {
    padding-top: 3.5rem;
    padding-bottom: 3rem;
    background: rgba(244, 237, 228, 0.45);
    border-top: 1px solid var(--color-rose-gold-light);
  }
  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(232, 213, 208, 0.6);
  }
  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .f-monogram {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--color-plum-deep);
    color: var(--color-canvas-ivory);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 1rem;
    border: 1px solid var(--color-rose-gold);
  }
  .f-name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-plum-deep);
  }
  .f-sub {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-rose-gold-text);
  }
  .footer-colophon {
    max-width: 480px;
    font-size: 0.8125rem;
    color: var(--color-taupe-muted);
    line-height: 1.5;
  }
  .colophon-p strong {
    color: var(--color-plum-deep);
  }
  .colophon-sub {
    font-size: 0.72rem;
    margin-top: 0.25rem;
  }
  .colophon-sub code {
    font-family: var(--font-mono);
    background: rgba(255, 253, 250, 0.8);
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    border: 1px solid var(--color-rose-gold-light);
  }
  .back-top-btn {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-plum-deep);
    text-decoration: none;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 253, 250, 0.8);
    border: 1px solid var(--color-rose-gold-light);
    transition: all var(--transition-fast);
  }
  .back-top-btn:hover {
    border-color: var(--color-rose-gold-text);
    color: var(--color-rose-gold-text);
  }
  .footer-bottom-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-taupe-muted);
  }
  @media (max-width: 900px) {
    .footer-content { flex-direction: column; align-items: flex-start; }
    .footer-bottom-row { flex-direction: column; align-items: flex-start; }
  }
</style>
