---
import type { ProjectData } from '../data/portfolioData';

type CarouselProject = Pick<ProjectData, 'id' | 'title' | 'subtitle' | 'tags' | 'description' | 'results' | 'limitationsAndDisclaimers' | 'links'> & { category: string; status: string };
interface Props { projects: CarouselProject[] }
const { projects } = Astro.props;
const artwork = (id: string) => {
  if (id === 'terraseg-ai') return { src: `${import.meta.env.BASE_URL}images/atelier/terraseg-terrain.webp`, alt: 'Satellite terrain relief with topographic contours and segmentation overlay', className: 'art-terrain' };
  if (id === 'aquaguard-ai') return { src: `${import.meta.env.BASE_URL}images/atelier/aquaguard-ecosystem.webp`, alt: 'Aquaculture water ecosystem with subtle analytical layers', className: 'art-water' };
  if (id === 'hospital-management-system') return { src: '', alt: 'Abstract connected-care workflow structure', className: 'art-care' };
  return { src: '', alt: 'Abstract branching decision-path structure', className: 'art-path' };
};
---

<div class="project-carousel" data-project-carousel data-count={projects.length} aria-label="Featured projects">
  <div class="carousel-atmosphere" aria-hidden="true">
    <div class="atmosphere-orbit"></div>
    <div class="atmosphere-core"></div>
    {Array.from({ length: 34 }, (_, i) => (
      <i class="atmosphere-particle" style={`--particle-index:${i}; --particle-x:${(i * 47 + 13) % 100}%; --particle-y:${(i * 31 + 9) % 100}%; --particle-size:${1 + (i % 3)}px; --particle-delay:${(i % 11) * -.7}s; --particle-duration:${12 + (i % 10)}s`}></i>
    ))}
  </div>

  <div class="carousel-topline">
    <span class="carousel-kicker"><i aria-hidden="true"></i> SELECTED WORK / 2024—26</span>
    <span class="carousel-count" data-carousel-count aria-live="polite">01 <b>/</b> 0{projects.length}</span>
  </div>

  <div class="project-carousel-stage" data-carousel-stage tabindex="0" aria-label="Project carousel. Use left and right arrow keys to change project.">
    <div class="project-track" data-carousel-track>
      {projects.map((project, index) => {
        const visual = artwork(project.id);
        return (
          <article class:list={['project-panel', visual.className]} data-carousel-index={index} data-project-id={project.id} role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${projects.length}: ${project.title}`}>
            <div class="panel-artwork" aria-hidden="true">
              {visual.src ? <img src={visual.src} alt="" width={project.id === 'terraseg-ai' ? 1536 : 1672} height={project.id === 'terraseg-ai' ? 1024 : 941} loading="lazy" decoding="async" /> : (
                <svg viewBox="0 0 640 720" preserveAspectRatio="xMidYMid slice" focusable="false">
                  <defs>
                    <linearGradient id={`art-gradient-${index}`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#e8dfdc"/><stop offset="1" stop-color="#b9a9bf"/></linearGradient>
                    <radialGradient id={`art-light-${index}`}><stop stop-color="#fffaf1" stop-opacity=".9"/><stop offset="1" stop-color="#fffaf1" stop-opacity="0"/></radialGradient>
                  </defs>
                  <rect width="640" height="720" fill={`url(#art-gradient-${index})`} />
                  <circle cx="420" cy="190" r="290" fill={`url(#art-light-${index})`} />
                  {project.id === 'hospital-management-system' ? (
                    <g fill="none" stroke="#68576f" stroke-opacity=".48">
                      <path d="M80 150H270V270H440V170H570M100 360H260V500H470V390H590M270 270V360M440 270V390" stroke-width="2" />
                      <path d="M95 135h155v70H95zM365 115h150v95H365zM150 315h150v90H150zM395 345h150v90H395zM225 470h185v90H225z" fill="#fffaf6" fill-opacity=".5" stroke-width="1.5" />
                      <circle cx="270" cy="270" r="9" fill="#b0849c"/><circle cx="440" cy="390" r="9" fill="#b0849c"/><circle cx="270" cy="360" r="7" fill="#c58f7d"/>
                      <path d="M121 170h92M121 185h58M390 150h92M390 166h63M177 350h92M177 368h61M420 380h92M420 397h60M250 505h115" stroke-width="3" stroke-linecap="round"/>
                    </g>
                  ) : (
                    <g fill="none" stroke="#54435f" stroke-opacity=".62" stroke-width="2">
                      <path d="M320 580V430M320 430L180 320M320 430L470 310M180 320L110 190M180 320L235 165M470 310L420 150M470 310L555 180M320 430V245M320 245L260 105M320 245L360 100" />
                      <g fill="#f9f5f1" stroke="#a57f9b" stroke-width="3"><circle cx="320" cy="580" r="15"/><circle cx="320" cy="430" r="12"/><circle cx="180" cy="320" r="10"/><circle cx="470" cy="310" r="10"/><circle cx="320" cy="245" r="10"/><circle cx="110" cy="190" r="8"/><circle cx="235" cy="165" r="8"/><circle cx="420" cy="150" r="8"/><circle cx="555" cy="180" r="8"/><circle cx="260" cy="105" r="7"/><circle cx="360" cy="100" r="7"/></g>
                    </g>
                  )}
                  <path d="M0 610C160 575 360 650 640 560V720H0Z" fill="#6d596f" fill-opacity=".11" />
                </svg>
              )}
              <div class="artwork-grain"></div>
              <span class="artwork-index">0{index + 1} <i>—</i> VISUAL STUDY</span>
            </div>

            <div class="panel-content">
              <div class="panel-meta">
                <span class="panel-category">{project.category}</span>
                <span class:list={['panel-status', { 'status-live': project.status === 'In Active Development' }]}><i aria-hidden="true"></i>{project.status}</span>
              </div>
              <p class="panel-overline">PROJECT / 0{index + 1}</p>
              <h3 class="panel-title">{project.title}</h3>
              <p class="panel-subtitle">{project.subtitle}</p>
              <p class="panel-description">{project.description}</p>
              <div class="panel-tags" aria-label="Technologies and domain">
                {project.tags.slice(0, 4).map(tag => <span>{tag}</span>)}
              </div>
              {project.results.length > 0 && (
                <div class="panel-result"><span>REPORTED RESULT</span><strong>{project.results[0].value}</strong><small>{project.results[0].metric} · {project.results[0].datasetOrProtocol}</small></div>
              )}
              <p class="panel-scope"><b>Scope</b> {project.limitationsAndDisclaimers[0]}</p>
              <div class="panel-actions">
                <a class="panel-story-link" href={`${import.meta.env.BASE_URL}projects/${project.id}/`}>
                  <span>Read the entire story</span><i aria-hidden="true">↗</i>
                </a>
                <div class="panel-resources" aria-label={`${project.title} resources`}>
                  {project.links.filter(link => !link.isPlaceholder).slice(0, 2).map(resource => (
                    <a href={resource.url} target={resource.isExternal ? '_blank' : undefined} rel={resource.isExternal ? 'noopener noreferrer' : undefined}>{resource.label}<span aria-hidden="true"> ↗</span></a>
                  ))}
                </div>
              </div>
              <span class="panel-watermark" aria-hidden="true">ATELIER</span>
            </div>
          </article>
        );
      })}
    </div>
    <div class="carousel-horizon" aria-hidden="true"></div>
  </div>

  <div class="carousel-controls">
    <div class="carousel-instruction"><span class="instruction-key">←</span><span class="instruction-key">→</span><span>Navigate selected work</span></div>
    <div class="carousel-dots" role="group" aria-label="Choose a project">
      {projects.map((project, index) => <button type="button" data-carousel-dot={index} aria-label={`Show ${project.title}`} aria-pressed={index === 0 ? 'true' : 'false'}><span></span></button>)}
    </div>
    <div class="carousel-arrows">
      <button type="button" data-carousel-prev aria-label="Previous project"><span aria-hidden="true">←</span></button>
      <button type="button" data-carousel-next aria-label="Next project"><span aria-hidden="true">→</span></button>
    </div>
  </div>
  <p class="carousel-announcement" data-carousel-announcement aria-live="polite" aria-atomic="true"></p>
</div>

<script>
  const roots = document.querySelectorAll<HTMLElement>('[data-project-carousel]:not([data-carousel-ready])');
  roots.forEach(root => {
    const stage = root.querySelector<HTMLElement>('[data-carousel-stage]');
    const track = root.querySelector<HTMLElement>('[data-carousel-track]');
    const count = Number(root.dataset.count || 0);
    if (!stage || !track || count < 2) return;
    const originals = [...track.querySelectorAll<HTMLElement>('[data-carousel-index]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]')];
    const countLabel = root.querySelector<HTMLElement>('[data-carousel-count]');
    const announcement = root.querySelector<HTMLElement>('[data-carousel-announcement]');
    const lifecycle = new AbortController();
    const { signal } = lifecycle;
    let navigationTimer = 0;
    let wheelTimer = 0;
    let transitionTimer = 0;
    let returnFrame = 0;
    let returnAnimation: Animation | null = null;
    window.addEventListener('pagehide', () => {
      lifecycle.abort();
      window.clearTimeout(navigationTimer);
      window.clearTimeout(wheelTimer);
      window.clearTimeout(transitionTimer);
      if (returnFrame) cancelAnimationFrame(returnFrame);
      returnAnimation?.cancel();
    }, { once: true });
    let active = 0;
    try {
      const returnId = sessionStorage.getItem('atelier-story-return');
      if (returnId) {
        const returnIndex = originals.findIndex(panel => panel.dataset.projectId === returnId);
        if (returnIndex >= 0) active = returnIndex;
      }
    } catch { /* The default first project remains available. */ }
    let pointerX = 0;
    let pointerY = 0;
    let touchStartX = 0;
    let touchStartY = 0;
    let wheelLocked = false;
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const startCardStory = (event: MouseEvent, link: HTMLAnchorElement, panel: HTMLElement) => {
      if (prefersReduced.matches || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const artwork = panel.querySelector<HTMLElement>('.panel-artwork');
      if (!artwork) return;
      event.preventDefault();
      const rect = panel.getBoundingClientRect();
      const artImage = artwork.querySelector<HTMLImageElement>('img');
      const artSvg = artwork.querySelector<SVGElement>('svg');
      const artSrc = artImage?.getAttribute('src') || (artSvg ? `data:image/svg+xml;charset=utf-8,${encodeURIComponent(new XMLSerializer().serializeToString(artSvg))}` : '');
      const projectId = panel.dataset.projectId || '';
      const storyState = { projectId, activeIndex: Number(panel.dataset.carouselIndex || 0), artSrc, returnHash: '#projects' };
      try { sessionStorage.setItem('atelier-story-transition', JSON.stringify(storyState)); sessionStorage.removeItem('atelier-entry-transition'); } catch { /* Navigation remains available without storage. */ }
      const overlay = document.createElement('div');
      overlay.className = 'story-flight';
      overlay.dataset.projectId = projectId;
      overlay.setAttribute('aria-hidden', 'true');
      const flight = panel.cloneNode(true) as HTMLElement;
      flight.className = 'story-flight-panel';
      flight.removeAttribute('aria-hidden');
      flight.querySelector('.panel-content')?.remove();
      flight.querySelector('.artwork-index')?.remove();
      const fragments = Array.from({ length: 5 }, (_, i) => `<i class="flight-fragment fragment-${i + 1}"></i>`).join('');
      const particles = Array.from({ length: 16 }, (_, i) => `<i class="flight-particle" style="--i:${i};--delay:${(i % 6) * 22}ms"></i>`).join('');
      const startX = rect.left, startY = rect.top, startW = rect.width, startH = rect.height;
      Object.assign(flight.style, { left: `${startX}px`, top: `${startY}px`, width: `${startW}px`, height: `${startH}px`, transformOrigin: 'center center', transform: 'perspective(1500px) translate3d(0,0,0) scale(1)', borderRadius: '3px', transition: 'transform 760ms cubic-bezier(.2,.78,.18,1), border-radius 760ms ease, box-shadow 760ms ease' });
      overlay.append(flight);
      overlay.insertAdjacentHTML('beforeend', `${fragments}${particles}`);
      const edgePoints = [
        { x: rect.left + rect.width * .18, y: rect.top + 2, angle: -12 },
        { x: rect.left + rect.width * .78, y: rect.top + 2, angle: 18 },
        { x: rect.right - 2, y: rect.top + rect.height * .7, angle: 96 },
        { x: rect.left + rect.width * .72, y: rect.bottom - 2, angle: 174 },
        { x: rect.left + 2, y: rect.top + rect.height * .36, angle: -84 }
      ];
      overlay.querySelectorAll<HTMLElement>('.flight-fragment').forEach((fragment, i) => {
        const point = edgePoints[i];
        Object.assign(fragment.style, { left: `${point.x}px`, top: `${point.y}px`, rotate: `${point.angle}deg`, '--tx': `${(i % 2 ? 1 : -1) * (42 + i * 11)}px`, '--ty': `${-54 - i * 13}px` });
      });
      overlay.querySelectorAll<HTMLElement>('.flight-particle').forEach((particle, i) => {
        const edge = edgePoints[i % edgePoints.length];
        const t = Math.floor(i / edgePoints.length);
        const spread = (t - 2) * 5;
        Object.assign(particle.style, { left: `${edge.x + spread}px`, top: `${edge.y + spread}px`, '--tx': `${(i % 2 ? 1 : -1) * (24 + t * 15)}px`, '--ty': `${-32 - ((i * 19) % 96)}px` });
      });
      document.body.append(overlay);
      document.documentElement.classList.add('story-flight-active');
      requestAnimationFrame(() => requestAnimationFrame(() => {
        overlay.classList.add('is-expanding');
        const targetX = innerWidth / 2 - (startX + startW / 2);
        const targetY = innerHeight / 2 - (startY + startH / 2);
        Object.assign(flight.style, { transform: `perspective(1500px) translate3d(${targetX}px,${targetY}px,180px) scale(${innerWidth / startW},${innerHeight / startH})`, borderRadius: '0px' });
      }));
      transitionTimer = window.setTimeout(() => { window.location.assign(link.href); }, 790);
    };

    // Five visible slots make the orbit legible even though the data set has four projects.
    const slotOffsets = [-2, -1, 0, 1, 2];
    let panels: HTMLElement[] = [];
    let navigationToken = 0;
    const modulo = (n: number, m: number) => ((n % m) + m) % m;
    const makePanel = (dataIndex: number, offset: number) => {
      const panel = originals[dataIndex].cloneNode(true) as HTMLElement;
      panel.dataset.carouselIndex = String(dataIndex);
      panel.dataset.slotOffset = String(offset);
      panel.classList.add('is-orbit-panel');
      return panel;
    };
    const buildRing = () => {
      const fragment = document.createDocumentFragment();
      panels = slotOffsets.map(offset => {
        const dataIndex = modulo(active + offset, count);
        const panel = makePanel(dataIndex, offset);
        fragment.append(panel);
        return panel;
      });
      track.replaceChildren(fragment);
    };
    const layout = (announce = false) => {
      panels.forEach(panel => {
        const offset = Number(panel.dataset.slotOffset || 0);
        const selected = offset === 0;
        panel.classList.toggle('is-active', selected);
        panel.classList.toggle('is-near', Math.abs(offset) === 1);
        panel.classList.toggle('is-far', Math.abs(offset) === 2);
        panel.style.setProperty('--arc-x', `${offset * (Math.abs(offset) >= 2 ? 43 : 62)}%`);
        panel.style.setProperty('--arc-y', `${Math.abs(offset) === 1 ? 12 : Math.abs(offset) === 2 ? -3 : 0}px`);
        panel.style.setProperty('--arc-rotation', `${offset * -1 * (Math.abs(offset) === 1 ? 23 : 35)}deg`);
        panel.style.setProperty('--arc-z', `${selected ? 100 : Math.abs(offset) === 1 ? -105 : -245}px`);
        panel.style.setProperty('--arc-scale', selected ? '1' : Math.abs(offset) === 1 ? '.83' : '.68');
        panel.setAttribute('aria-hidden', String(!selected));
        panel.querySelectorAll<HTMLElement>('a,button,[tabindex]').forEach(el => el.tabIndex = selected ? 0 : -1);
        panel.querySelectorAll('a').forEach(link => link.setAttribute('draggable', 'false'));
      });
      dots.forEach((dot, index) => dot.setAttribute('aria-pressed', String(index === active)));
      if (countLabel) countLabel.innerHTML = `${String(active + 1).padStart(2, '0')} <b>/</b> ${String(count).padStart(2, '0')}`;
      if (announce && announcement) announcement.textContent = `Selected ${originals[active]?.querySelector('.panel-title')?.textContent?.trim() || 'project'}; ${active + 1} of ${count}.`;
      root.dataset.activeIndex = String(active);
    };
    const stepRing = (direction: number, final = false) => {
      active = modulo(active + direction, count);
      const nextPanels: HTMLElement[] = [];
      for (const panel of panels) {
        const nextOffset = Number(panel.dataset.slotOffset || 0) - direction;
        if (nextOffset < -2 || nextOffset > 2) { panel.remove(); continue; }
        panel.dataset.slotOffset = String(nextOffset);
        panel.dataset.carouselIndex = String(modulo(active + nextOffset, count));
        nextPanels.push(panel);
      }
      const enteringOffset = direction > 0 ? 3 : -3;
      const incoming = makePanel(modulo(active + enteringOffset, count), enteringOffset);
      incoming.classList.add('is-entering');
      incoming.style.setProperty('--arc-x', `${enteringOffset * 43}%`);
      incoming.style.setProperty('--arc-y', '-8px');
      incoming.style.setProperty('--arc-rotation', `${enteringOffset > 0 ? -42 : 42}deg`);
      incoming.style.setProperty('--arc-z', '-355px');
      incoming.style.setProperty('--arc-scale', '.54');
      track.append(incoming);
      nextPanels.push(incoming);
      panels = nextPanels;
      layout(final);
      requestAnimationFrame(() => {
        incoming.classList.remove('is-entering');
        incoming.dataset.slotOffset = String(direction > 0 ? 2 : -2);
        layout(final);
      });
    };
    const select = (index: number, announce = true, directionHint = 0) => {
      const next = modulo(index, count);
      if (next === active) return;
      const forwardDistance = modulo(next - active, count);
      const direction = directionHint || (forwardDistance <= count / 2 ? 1 : -1);
      const steps = directionHint ? (directionHint > 0 ? forwardDistance : modulo(active - next, count)) : Math.min(forwardDistance, count - forwardDistance);
      const token = ++navigationToken;
      window.clearTimeout(navigationTimer);
      root.setAttribute('aria-busy', 'true');
      let step = 0;
      const advance = () => {
        if (token !== navigationToken) return;
        step += 1;
        stepRing(direction, announce && step === steps);
        if (step < steps) navigationTimer = window.setTimeout(advance, 300);
        else { navigationTimer = 0; root.removeAttribute('aria-busy'); }
      };
      advance();
    };

    root.dataset.carouselReady = 'true';
    root.classList.add('is-ready');
    buildRing();
    layout();
    try {
      if (sessionStorage.getItem('atelier-story-return')) {
        sessionStorage.removeItem('atelier-story-return');
        sessionStorage.removeItem('atelier-entry-transition');
        const savedArt = sessionStorage.getItem('atelier-story-artwork') || '';
        sessionStorage.removeItem('atelier-story-artwork');
        navigationTimer = window.setTimeout(() => {
          const selected = track.querySelector<HTMLElement>('.is-active');
          if (!selected) return;
          selected.scrollIntoView({ block: 'center', behavior: 'instant' });
          if (prefersReduced.matches) return;
          returnFrame = requestAnimationFrame(() => { returnFrame = requestAnimationFrame(() => {
            const rect = selected.getBoundingClientRect();
            const reverse = document.createElement('div'); reverse.className = 'story-return-flight'; reverse.setAttribute('aria-hidden','true');
            if (savedArt.startsWith('data:image/svg+xml') || (savedArt.startsWith('/') && savedArt.includes('/images/atelier/'))) { const image = document.createElement('img'); image.src = savedArt; reverse.append(image); }
            document.body.append(reverse);
            const x = rect.left + rect.width / 2 - innerWidth / 2;
            const y = rect.top + rect.height / 2 - innerHeight / 2;
            const transform = `translate3d(${x}px,${y}px,0) scale(${rect.width / innerWidth},${rect.height / innerHeight})`;
            returnAnimation = reverse.animate([{ transform:'translate3d(0,0,0) scale(1)', borderRadius:'0px', opacity:1 },{ transform, borderRadius:'3px', opacity:.08 }],{duration:760,easing:'cubic-bezier(.2,.78,.18,1)',fill:'forwards'});
            returnAnimation.finished.then(()=>reverse.remove(),()=>reverse.remove());
          }); });
        }, 80);
      }
    } catch { /* The restored slide remains selected without the reversal overlay. */ }
    root.querySelector('[data-carousel-prev]')?.addEventListener('click', () => select(active - 1), { signal });
    root.querySelector('[data-carousel-next]')?.addEventListener('click', () => select(active + 1), { signal });
    dots.forEach((dot, index) => dot.addEventListener('click', () => select(index), { signal }));

    stage.addEventListener('click', event => {
      const target = event.target as HTMLElement;
      const panel = target.closest<HTMLElement>('[data-slot-offset]');
      if (!panel) return;
      const offset = Number(panel.dataset.slotOffset || 0);
      const storyLink = target.closest<HTMLAnchorElement>('.panel-story-link');
      if (offset === 0 && storyLink) { startCardStory(event, storyLink, panel); return; }
      if (offset !== 0) {
        event.preventDefault();
        event.stopPropagation();
        select(modulo(active + offset, count), true, Math.sign(offset));
      }
    }, { signal });
    stage.addEventListener('keydown', event => {
      if (event.altKey || event.ctrlKey || event.metaKey) return;
      if (event.key === 'ArrowRight') { event.preventDefault(); select(active + 1); }
      if (event.key === 'ArrowLeft') { event.preventDefault(); select(active - 1); }
      if (event.key === 'Home') { event.preventDefault(); select(0); }
      if (event.key === 'End') { event.preventDefault(); select(count - 1); }
    }, { signal });
    stage.addEventListener('pointerdown', event => {
      if (event.pointerType !== 'touch') return;
      touchStartX = event.clientX;
      touchStartY = event.clientY;
    }, { passive: true, signal });
    stage.addEventListener('pointerup', event => {
      if (event.pointerType !== 'touch') return;
      const dx = event.clientX - touchStartX;
      const dy = event.clientY - touchStartY;
      if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.25) select(active + (dx < 0 ? 1 : -1));
    }, { passive: true, signal });
    stage.addEventListener('pointermove', event => {
      if (prefersReduced.matches || event.pointerType !== 'mouse') return;
      const bounds = stage.getBoundingClientRect();
      pointerX = (event.clientX - bounds.left) / bounds.width - .5;
      pointerY = (event.clientY - bounds.top) / bounds.height - .5;
      stage.style.setProperty('--pointer-x', `${(pointerX * 4).toFixed(2)}px`);
      stage.style.setProperty('--pointer-y', `${(pointerY * -3).toFixed(2)}px`);
    }, { passive: true, signal });
    stage.addEventListener('pointerleave', () => {
      stage.style.setProperty('--pointer-x', '0px');
      stage.style.setProperty('--pointer-y', '0px');
    }, { passive: true, signal });
    stage.addEventListener('wheel', event => {
      if (prefersReduced.matches || wheelLocked || Math.abs(event.deltaX) < Math.abs(event.deltaY) * .65) return;
      if (Math.abs(event.deltaX) < 32) return;
      event.preventDefault();
      wheelLocked = true;
      select(active + (event.deltaX > 0 ? 1 : -1));
      wheelTimer = window.setTimeout(() => { wheelLocked = false; }, 760);
    }, { passive: false, signal });
    prefersReduced.addEventListener?.('change', () => {
      if (prefersReduced.matches) { stage.style.setProperty('--pointer-x', '0px'); stage.style.setProperty('--pointer-y', '0px'); }
    }, { signal });
  });
</script>

<style>
  .project-carousel {
    --panel-width: min(69vw, 770px);
    --ink: #211923;
    --plum: #513a53;
    position: relative;
    isolation: isolate;
    margin: clamp(2.5rem, 5vw, 4rem) calc((min(100vw - 3rem, 1450px) - min(100vw - 3rem, 1320px)) / -2) 0;
    padding: 30px clamp(20px, 5vw, 72px) 22px;
    overflow: hidden;
    color: #f8f1eb;
    border: 1px solid rgba(205,178,192,.18);
    border-radius: 5px;
    background:
      radial-gradient(ellipse at 48% 42%, rgba(106,76,110,.42), transparent 40%),
      radial-gradient(ellipse at 84% 60%, rgba(132,99,108,.13), transparent 35%),
      linear-gradient(118deg, #201822 0%, #2a202e 52%, #17141d 100%);
